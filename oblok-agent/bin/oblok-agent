#!/usr/bin/env php
<?php

declare(strict_types=1);

spl_autoload_register(function (string $class): void {
    $prefix = 'OblokAgent\\';

    if (! str_starts_with($class, $prefix)) {
        return;
    }

    $file = __DIR__.'/../src/'.str_replace('\\', '/', substr($class, strlen($prefix))).'.php';

    if (is_file($file)) {
        require $file;
    }
});

use OblokAgent\ApiClient;
use OblokAgent\Config;
use OblokAgent\Runner;

$env = getenv();

foreach ($argv as $arg) {
    if (str_starts_with($arg, '--log=')) {
        $env['OBLOK_LOG_FILES'] = substr($arg, 6);
    } elseif (str_starts_with($arg, '--access-log=')) {
        $env['OBLOK_ACCESS_LOG'] = substr($arg, 13);
    }
}

$config = Config::fromEnv($env);

if ($config->baseUrl === '' || $config->apiKey === '' || $config->projectId === '') {
    fwrite(STDERR, "oblok-agent: missing OBLOK_URL, OBLOK_API_KEY, or OBLOK_PROJECT_ID\n");
    exit(1);
}

if ($config->logFiles === [] && $config->accessLogFile === null) {
    fwrite(STDERR, "oblok-agent: nothing to tail. Set OBLOK_LOG_FILES and/or OBLOK_ACCESS_LOG\n");
    exit(1);
}

$client = new ApiClient($config->baseUrl, $config->apiKey, $config->projectId);
$runner = new Runner($config, $client);

fwrite(STDOUT, "oblok-agent: shipping logs+metrics to {$config->baseUrl} as {$config->agentName}\n");

$runner->run();
