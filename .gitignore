# Dependencies
/vendor
/node_modules

# Environment & Credentials
.env
.env.*
!.env.example
*.key

# Laravel Storage & Cache
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/testing/*
/storage/framework/views/*
/storage/logs/*
!/storage/framework/cache/data/.gitignore
!/storage/framework/sessions/.gitignore
!/storage/framework/testing/.gitignore
!/storage/framework/views/.gitignore
!/storage/logs/.gitignore
/public/storage

# Vite & Node Build Artifacts
# Note: /public/build is committed intentionally so self-hosted deploys
# ship with a working frontend (no npm build step required).
#/public/build
/public/hot
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Docker Local Data Volumes
postgres_data/
redis_data/

# IDEs & System Files
.DS_Store
Thumbs.db
.idea/
.vscode/
.commandcode/
*.sublime-project
*.sublime-workspace

# Testing & Coverage
